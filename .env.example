# SafeShift AI — Environment Variables
# Copy this file to .env and fill in your real API key.
# NEVER commit the real .env file to version control.

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Google API Keys (Safe Enhanced Mode)
# For local testing, you can use the same Google Cloud API key for all three endpoints.
# Ensure that the key has both Places API (New) and Routes API enabled in Google Cloud Console.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_ROUTES_API_KEY=your_google_routes_api_key_here

